<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login | Kabadiwala Connect</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-amber-50 text-gray-800">
  <header class="bg-white shadow-sm">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
      <a href="index.html" class="font-bold text-green-800">♻ Kabadiwala Connect</a>
      <a href="index.html" class="text-green-700 hover:underline">Back to home</a>
    </div>
  </header>

  <main class="mx-auto max-w-md px-5 py-16">
    <form class="rounded-2xl bg-white p-8 shadow-sm" onsubmit="event.preventDefault(); alert('Login is a prototype and is not connected yet.');">
      <h1 class="text-3xl font-bold">Login</h1>
      <p class="mt-2 text-gray-600">Enter your mobile number to continue.</p>

      <label class="mt-6 block font-semibold">
        Mobile number
        <input type="tel" required placeholder="Enter your mobile number"
               class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-3" />
      </label>

      <button type="submit"
              class="mt-5 w-full rounded-lg bg-green-700 px-6 py-3 font-bold text-white hover:bg-green-800">
        Continue
      </button>

      <p class="mt-4 text-center text-sm text-gray-500">
        Prototype login: it is not connected to the backend yet.
      </p>
    </form>
  </main>
</body>
</html>
