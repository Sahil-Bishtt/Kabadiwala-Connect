<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Get Started | Kabadiwala Connect</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body class="min-h-screen bg-amber-50 text-gray-800">
    <header class="bg-white shadow-sm">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
        <a href="index.html" class="font-bold text-green-800">
          ♻ Kabadiwala Connect
        </a>
        <a href="index.html" class="text-green-700 hover:underline">
          Back to home
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-5 py-16">
      <div class="text-center">
        <p class="font-semibold uppercase tracking-widest text-green-700">
          Welcome
        </p>
        <h1 class="mt-2 text-4xl font-bold">How would you like to use Kabadiwala Connect?</h1>
        <p class="mx-auto mt-4 max-w-2xl text-gray-600">
          Choose the option that fits you. You can change this page as your prototype grows.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-3xl gap-6 md:grid-cols-2">
        <article class="rounded-2xl border border-green-100 bg-white p-8 text-center shadow-sm">
          <div class="text-5xl">🏠</div>
          <h2 class="mt-4 text-2xl font-bold">I’m a Household</h2>
          <p class="mt-3 text-gray-600">
            I want to arrange a pickup for recyclable scrap from my home.
          </p>
          <a href="index.html#pickup"
             class="mt-6 inline-block rounded-lg bg-green-700 px-6 py-3 font-bold text-white hover:bg-green-800">
            Request a pickup
          </a>
        </article>

        <article class="rounded-2xl border border-green-100 bg-white p-8 text-center shadow-sm">
          <div class="text-5xl">♻️</div>
          <h2 class="mt-4 text-2xl font-bold">I’m a Collector</h2>
          <p class="mt-3 text-gray-600">
            I collect recyclable materials and want to find pickup requests.
          </p>
          <button
            type="button"
            onclick="alert('Collector features are coming soon!')"
            class="mt-6 rounded-lg border border-green-700 px-6 py-3 font-bold text-green-800 hover:bg-green-50">
            Continue as collector
          </button>
        </article>
      </div>
    </main>
  </body>
</html>
