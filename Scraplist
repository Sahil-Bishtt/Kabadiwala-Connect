<!doctype html>
<html lang="en">
<head>
  <!-- Page setup -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Scrap List | Kabadiwala Connect</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <!-- Dark mode styles -->
  <style>
    body {
      transition: background-color 0.25s, color 0.25s;
    }

    body.dark-mode {
      background: #111827;
      color: #f3f4f6;
    }

    body.dark-mode header,
    body.dark-mode article {
      background: #1f2937;
      color: #f3f4f6;
      border-color: #374151;
    }

    body.dark-mode p {
      color: #d1d5db;
    }

    body.dark-mode #themeToggle {
      background: #1f2937;
      color: #f3f4f6;
    }
  </style>
</head>

<body class="min-h-screen bg-amber-50 text-gray-800">

  <!-- Header -->
  <header class="bg-white shadow-sm">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-4">
      <a href="index.html" class="font-bold text-green-800">
        ♻ Kabadiwala Connect
      </a>

      <div class="flex items-center gap-3">
        <button id="themeToggle" type="button"
                class="rounded-lg border border-green-700 px-4 py-2 font-semibold text-green-800">
          🌙 Dark mode
        </button>

        <a href="index.html" class="text-green-700 hover:underline">
          Back to home
        </a>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-5 py-16">

    <!-- Page introduction -->
    <section class="mb-10 text-center">
      <p class="font-semibold uppercase tracking-widest text-green-700">
        Recycle and reuse
      </p>

      <h1 class="mt-2 text-4xl font-bold">
        Scrap list and sample prices
      </h1>

      <p class="mt-3 text-gray-600">
        These are sample prototype prices. Actual rates may vary.
      </p>
    </section>

    <!-- Scrap item cards -->
    <section class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

      <article class="rounded-xl border border-green-100 bg-white p-6 shadow-sm">
        <div class="mb-3 text-4xl">🧴</div>
        <h2 class="text-xl font-bold">Plastic</h2>
        <p class="mt-2 text-green-700">₹15 per kg</p>
      </article>

      <article class="rounded-xl border border-green-100 bg-white p-6 shadow-sm">
        <div class="mb-3 text-4xl">📄</div>
        <h2 class="text-xl font-bold">Paper</h2>
        <p class="mt-2 text-green-700">₹12 per kg</p>
      </article>

      <article class="rounded-xl border border-green-100 bg-white p-6 shadow-sm">
        <div class="mb-3 text-4xl">🔩</div>
        <h2 class="text-xl font-bold">Metal</h2>
        <p class="mt-2 text-green-700">₹35 per kg</p>
      </article>

      <article class="rounded-xl border border-green-100 bg-white p-6 shadow-sm">
        <div class="mb-3 text-4xl">💻</div>
        <h2 class="text-xl font-bold">E-waste</h2>
        <p class="mt-2 text-green-700">₹50 per kg</p>
      </article>

      <article class="rounded-xl border border-green-100 bg-white p-6 shadow-sm">
        <div class="mb-3 text-4xl">🍂</div>
        <h2 class="text-xl font-bold">Organic</h2>
        <p class="mt-2 text-green-700">₹5 per kg</p>
      </article>

      <article class="rounded-xl border border-green-100 bg-white p-6 shadow-sm">
        <div class="mb-3 text-4xl">📦</div>
        <h2 class="text-xl font-bold">Other</h2>
        <p class="mt-2 text-green-700">Price depends on the material</p>
      </article>

    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-green-950 py-6 text-center text-green-100">
    <p>Kabadiwala Connect · Making recycling easier</p>
  </footer>

  <!-- Shared saved theme -->
  <script>
    const themeToggle = document.getElementById("themeToggle");

    function applyTheme() {
      const isDark = localStorage.getItem("kabadiwala-theme") === "dark";
      document.body.classList.toggle("dark-mode", isDark);
      themeToggle.textContent = isDark ? "☀️ Light mode" : "🌙 Dark mode";
    }

    applyTheme();

    themeToggle.addEventListener("click", () => {
      const isDark = !document.body.classList.contains("dark-mode");
      localStorage.setItem("kabadiwala-theme", isDark ? "dark" : "light");
      applyTheme();
    });
  </script>
</body>
</html>
