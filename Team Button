  <script>
    const themeToggle = document.getElementById("themeToggle");
    const languageSelect = document.getElementById("languageSelect");
    const themeIcon = document.getElementById("themeToggleIcon");
    const themeText = document.getElementById("themeToggleText");

    function applyTheme() {
      const isDark = localStorage.getItem("kabadiwala-theme") === "dark";

      document.documentElement.classList.toggle("dark", isDark);
      document.body.classList.toggle("dark", isDark);

      themeIcon.textContent = isDark ? "☀️" : "🌙";
      themeText.textContent = isDark
        ? (languageSelect.value === "hi" ? "लाइट मोड" : "Light mode")
        : (languageSelect.value === "hi" ? "डार्क मोड" : "Dark mode");
    }

    function applyLanguage(language) {
      document.documentElement.lang = language;

      document.querySelectorAll("[data-en][data-hi]").forEach((element) => {
        const translated = element.dataset[language];
        if (translated) element.textContent = translated;
      });

      languageSelect.value = language;
      applyTheme();
    }

    applyTheme();
    applyLanguage(localStorage.getItem("kabadiwala-language") || "en");

    themeToggle.addEventListener("click", () => {
      const isDark = !document.documentElement.classList.contains("dark");
      localStorage.setItem("kabadiwala-theme", isDark ? "dark" : "light");
      applyTheme();
    });

    languageSelect.addEventListener("change", (event) => {
      localStorage.setItem("kabadiwala-language", event.target.value);
      applyLanguage(event.target.value);
    });

    const userRaw = localStorage.getItem("kabadiwala_user");
    const loginLink = document.getElementById("loginNavLink");

    if (userRaw && loginLink) {
      try {
        const user = JSON.parse(userRaw);
        const accountArea = loginLink.parentElement;

        accountArea.innerHTML = `
          <span class="rounded-lg border border-green-300 bg-green-100 px-3 py-2 text-xs font-medium text-green-800 dark:border-green-700 dark:bg-green-900/40 dark:text-green-300">
            👤 ${user.name} (${user.user_type})
          </span>
          <button id="logoutBtn" type="button"
                  class="px-2 py-2 text-xs font-semibold text-red-600 hover:underline dark:text-red-400">
            Logout
          </button>
        `;

        document.getElementById("logoutBtn").addEventListener("click", () => {
          localStorage.removeItem("kabadiwala_user");
          window.location.reload();
        });
      } catch (error) {
        localStorage.removeItem("kabadiwala_user");
      }
    }
  </script>
</body>
</html>
