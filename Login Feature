<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Login or register with Kabadiwala Connect." />
  <title>Login / Register | Kabadiwala Connect</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <style type="text/tailwindcss">
    @custom-variant dark (&:where(.dark, .dark *));
  </style>

  <style>
    body {
      transition: background-color .25s, color .25s;
    }

    body.dark-mode {
      background: #111827;
      color: #f3f4f6;
    }

    body.dark-mode header,
    body.dark-mode #loginCard {
      background: #1f2937;
      color: #f3f4f6;
      border-color: #374151;
    }

    body.dark-mode input,
    body.dark-mode select,
    body.dark-mode #themeToggle {
      background: #111827;
      color: #f3f4f6;
      border-color: #4b5563;
    }

    body.dark-mode p {
      color: #d1d5db;
    }

    .tab-active {
      background: #15803d;
      color: #ffffff;
    }

    .tab-inactive {
      background: #f3f4f6;
      color: #14532d;
    }

    .tab-inactive:hover {
      background: #dcfce7;
    }

    body.dark-mode .tab-active {
      background: #22c55e;
      color: #052e16;
    }

    body.dark-mode .tab-inactive {
      background: #374151;
      color: #f9fafb;
    }

    body.dark-mode .tab-inactive:hover {
      background: #4b5563;
      color: #ffffff;
    }
  </style>
</head>

<body class="min-h-screen bg-amber-50 text-gray-800">
  <header class="bg-white shadow-sm">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-5 py-4">
      <a href="website.html" class="font-bold text-green-800 dark:text-green-300">
        ♻ Kabadiwala Connect
      </a>

      <div class="flex flex-wrap items-center gap-3">
        <label for="languageSelect" class="sr-only">Choose language</label>
        <select id="languageSelect" aria-label="Choose language"
                class="rounded-lg border border-green-700 bg-white px-3 py-2 font-semibold text-green-800">
          <option value="en">English</option>
          <option value="hi">हिन्दी</option>
        </select>

        <button id="themeToggle" type="button"
                class="rounded-lg border border-green-700 px-4 py-2 font-semibold text-green-800">
          🌙 Dark mode
        </button>

        <a href="website.html" class="text-green-700 hover:underline"
           data-en="Back to home" data-hi="मुखपृष्ठ पर वापस जाएँ">
          Back to home
        </a>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-lg px-5 py-12 sm:py-16">
    <section id="loginCard" class="rounded-2xl border border-green-100 bg-white p-6 shadow-lg sm:p-8">
      <div class="text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-green-700"
           data-en="Welcome" data-hi="स्वागत है">
          Welcome
        </p>

        <h1 class="mt-2 text-3xl font-extrabold"
            data-en="Your Kabadiwala Connect account"
            data-hi="आपका कबाड़ीवाला कनेक्ट खाता">
          Your Kabadiwala Connect account
        </h1>

        <p class="mt-2 text-gray-600"
           data-en="Log in or create an account using your mobile number."
           data-hi="अपने मोबाइल नंबर से लॉग इन करें या खाता बनाएँ।">
          Log in or create an account using your mobile number.
        </p>
      </div>

      <div class="mt-6 grid grid-cols-2 rounded-xl border border-green-200 bg-green-50 p-1">
        <button id="loginTab" type="button"
                class="tab-active rounded-lg px-4 py-2.5 font-bold"
                data-en="Login" data-hi="लॉग इन">
          Login
        </button>

        <button id="registerTab" type="button"
                class="tab-inactive rounded-lg px-4 py-2.5 font-bold"
                data-en="Register" data-hi="पंजीकरण">
          Register
        </button>
      </div>

      <!-- LOGIN PANEL -->
      <div id="loginPanel" class="mt-6">
        <p class="text-sm text-gray-600"
           data-en="Enter the same country code and mobile number you used when registering."
           data-hi="पंजीकरण के समय वाला देश कोड और मोबाइल नंबर दर्ज करें।">
          Enter the same country code and mobile number you used when registering.
        </p>

        <label for="loginCountry" class="mt-5 block font-semibold"
               data-en="Country code" data-hi="देश का कोड">
          Country code
        </label>

        <div class="mt-2 grid grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] gap-2">
          <select id="loginCountry"
                  class="min-w-0 rounded-lg border border-gray-300 bg-white px-3 py-3"
                  aria-label="Login country code"></select>

          <input id="loginMobile" type="tel" inputmode="numeric"
                 autocomplete="tel-national" placeholder="Mobile number"
                 class="min-w-0 rounded-lg border border-gray-300 px-4 py-3" />
        </div>

        <div class="mt-5 rounded-xl border border-green-200 bg-green-50 p-4">
          <label for="loginCaptchaInput" class="block font-semibold"
                 data-en="Quick check: solve this addition"
                 data-hi="छोटी जाँच: यह जोड़ हल करें">
            Quick check: solve this addition
          </label>

          <div class="mt-3 flex items-center gap-3">
            <span id="loginCaptchaQuestion"
                  class="rounded-lg bg-white px-4 py-2 text-lg font-bold text-green-800"
                  aria-live="polite"></span>

            <button id="refreshLoginCaptcha" type="button"
                    class="rounded-lg border border-green-700 px-3 py-2 text-sm font-semibold text-green-800"
                    data-en="New question" data-hi="नया सवाल">
              New question
            </button>
          </div>

          <input id="loginCaptchaInput" type="number" inputmode="numeric"
                 placeholder="Your answer"
                 class="mt-3 w-full rounded-lg border border-gray-300 px-4 py-3" />
        </div>

        <button id="requestButton" type="button"
                class="mt-5 w-full rounded-lg bg-green-700 px-6 py-3 font-bold text-white hover:bg-green-800"
                data-en="Request OTP" data-hi="OTP माँगें">
          Request OTP
        </button>

        <div id="otpArea" class="mt-5 hidden">
          <label for="otp" class="block font-semibold"
                 data-en="Enter OTP" data-hi="OTP दर्ज करें">
            Enter OTP
          </label>

          <input id="otp" type="text" inputmode="numeric" maxlength="4"
                 autocomplete="one-time-code" placeholder="4-digit OTP"
                 class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-3" />

          <button id="verifyButton" type="button"
                  class="mt-4 w-full rounded-lg bg-green-700 px-6 py-3 font-bold text-white hover:bg-green-800"
                  data-en="Verify and log in"
                  data-hi="सत्यापित करें और लॉग इन करें">
            Verify and log in
          </button>
        </div>
      </div>

      <!-- REGISTRATION PANEL -->
      <form id="registerPanel" class="mt-6 hidden">
        <p class="text-sm text-gray-600"
           data-en="Create an account to get started."
           data-hi="शुरू करने के लिए अपना खाता बनाएँ।">
          Create an account to get started.
        </p>

        <label for="registerName" class="mt-5 block font-semibold"
               data-en="Full name" data-hi="पूरा नाम">
          Full name
        </label>

        <input id="registerName" type="text" autocomplete="name"
               required minlength="2" maxlength="40"
               placeholder="Enter your name"
               class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-3" />

        <label for="registerCountry" class="mt-4 block font-semibold"
               data-en="Country code" data-hi="देश का कोड">
          Country code
        </label>

        <div class="mt-2 grid grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] gap-2">
          <select id="registerCountry" required
                  class="min-w-0 rounded-lg border border-gray-300 bg-white px-3 py-3"
                  aria-label="Registration country code"></select>

          <input id="registerMobile" type="tel" inputmode="numeric"
                 autocomplete="tel-national" required
                 placeholder="Mobile number"
                 class="min-w-0 rounded-lg border border-gray-300 px-4 py-3" />
        </div>

        <p class="mt-2 text-xs text-gray-500"
           data-en="Choose your code first, then enter your number without the country code."
           data-hi="पहले देश का कोड चुनें, फिर देश के कोड के बिना अपना नंबर दर्ज करें।">
          Choose your code first, then enter your number without the country code.
        </p>

        <label for="userType" class="mt-4 block font-semibold"
               data-en="I am registering as"
               data-hi="मैं इस रूप में पंजीकरण कर रहा/रही हूँ">
          I am registering as
        </label>

        <select id="userType" required
                class="mt-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-3">
          <option value="Household" data-en="Household" data-hi="परिवार">
            Household
          </option>
          <option value="Collector" data-en="Scrap collector" data-hi="कबाड़ संग्रहकर्ता">
            Scrap collector
          </option>
        </select>

        <div class="mt-5 rounded-xl border border-green-200 bg-green-50 p-4">
          <label for="registerCaptchaInput" class="block font-semibold"
                 data-en="Quick check: solve this addition"
                 data-hi="छोटी जाँच: यह जोड़ हल करें">
            Quick check: solve this addition
          </label>

          <div class="mt-3 flex items-center gap-3">
            <span id="registerCaptchaQuestion"
                  class="rounded-lg bg-white px-4 py-2 text-lg font-bold text-green-800"
                  aria-live="polite"></span>

            <button id="refreshRegisterCaptcha" type="button"
                    class="rounded-lg border border-green-700 px-3 py-2 text-sm font-semibold text-green-800"
                    data-en="New question" data-hi="नया सवाल">
              New question
            </button>
          </div>

          <input id="registerCaptchaInput" type="number" inputmode="numeric"
                 required placeholder="Your answer"
                 class="mt-3 w-full rounded-lg border border-gray-300 px-4 py-3" />
        </div>

        <button id="registerButton" type="submit"
                class="mt-5 w-full rounded-lg bg-green-700 px-6 py-3 font-bold text-white hover:bg-green-800"
                data-en="Create account" data-hi="खाता बनाएँ">
          Create account
        </button>
      </form>

      <p id="message" role="status" aria-live="polite" class="mt-4 text-sm"></p>
    </section>
  </main>

  <script>
    const countries = [
      ["IN", "+91", "India"],
      ["US", "+1", "United States"],
      ["GB", "+44", "United Kingdom"],
      ["CA", "+1", "Canada"],
      ["AU", "+61", "Australia"],
      ["NZ", "+64", "New Zealand"],
      ["AE", "+971", "United Arab Emirates"],
      ["NP", "+977", "Nepal"],
      ["PK", "+92", "Pakistan"],
      ["BD", "+880", "Bangladesh"],
      ["SG", "+65", "Singapore"],
      ["DE", "+49", "Germany"],
      ["FR", "+33", "France"],
      ["ZA", "+27", "South Africa"]
    ];

    const languageSelect = document.getElementById("languageSelect");
    const message = document.getElementById("message");
    const loginPanel = document.getElementById("loginPanel");
    const registerPanel = document.getElementById("registerPanel");
    const loginTab = document.getElementById("loginTab");
    const registerTab = document.getElementById("registerTab");
    const countryCodeStorageKey = "kabadiwala-country-code";

    function fillCountryOptions(select) {
      countries.forEach(([iso, code, name]) => {
        const option = document.createElement("option");
        option.value = code;
        option.textContent = `${name} (${code})`;
        option.dataset.iso = iso;
        select.appendChild(option);
      });

      const savedCode = localStorage.getItem(countryCodeStorageKey) || "+91";
      select.value = countries.some((country) => country[1] === savedCode)
        ? savedCode
        : "+91";
    }

    const loginCountry = document.getElementById("loginCountry");
    const registerCountry = document.getElementById("registerCountry");

    fillCountryOptions(loginCountry);
    fillCountryOptions(registerCountry);

    loginCountry.value = registerCountry.value =
      localStorage.getItem(countryCodeStorageKey) || "+91";

    [loginCountry, registerCountry].forEach((select) => {
      select.addEventListener("change", () => {
        localStorage.setItem(countryCodeStorageKey, select.value);
        loginCountry.value = registerCountry.value = select.value;
      });
    });

    // Apply and save the theme across pages.
    const themeToggle = document.getElementById("themeToggle");

    function applyTheme() {
      const isDark = localStorage.getItem("kabadiwala-theme") === "dark";
      document.body.classList.toggle("dark-mode", isDark);
      document.documentElement.classList.toggle("dark", isDark);

      themeToggle.textContent = isDark ? "☀️ Light mode" : "🌙 Dark mode";
    }

    applyTheme();

    themeToggle.addEventListener("click", () => {
      const isDark = !document.body.classList.contains("dark-mode");
      localStorage.setItem("kabadiwala-theme", isDark ? "dark" : "light");
      applyTheme();
    });

    // Apply saved English or Hindi language.
    function applyLanguage(language) {
      document.documentElement.lang = language;

      document.querySelectorAll("[data-en][data-hi]").forEach((element) => {
        const translation = element.dataset[language];
        if (translation) element.textContent = translation;
      });

      languageSelect.value = language;

      const isDark = localStorage.getItem("kabadiwala-theme") === "dark";
      themeToggle.textContent = isDark
        ? (language === "hi" ? "☀️ लाइट मोड" : "☀️ Light mode")
        : (language === "hi" ? "🌙 डार्क मोड" : "🌙 Dark mode");
    }

    applyLanguage(localStorage.getItem("kabadiwala-language") || "en");

    languageSelect.addEventListener("change", (event) => {
      localStorage.setItem("kabadiwala-language", event.target.value);
      applyLanguage(event.target.value);
    });

    function switchPanel(showRegister) {
      loginPanel.classList.toggle("hidden", showRegister);
      registerPanel.classList.toggle("hidden", !showRegister);

      loginTab.className = showRegister
        ? "tab-inactive rounded-lg px-4 py-2.5 font-bold"
        : "tab-active rounded-lg px-4 py-2.5 font-bold";

      registerTab.className = showRegister
        ? "tab-active rounded-lg px-4 py-2.5 font-bold"
        : "tab-inactive rounded-lg px-4 py-2.5 font-bold";

      message.textContent = "";
    }

    loginTab.addEventListener("click", () => switchPanel(false));
    registerTab.addEventListener("click", () => switchPanel(true));

    function phoneNumber(countrySelect, phoneInput) {
      const localDigits = phoneInput.value
        .replace(/\D/g, "")
        .replace(/^0+/, "");

      const fullNumber = countrySelect.value + localDigits;
      const digitCount = fullNumber.replace(/\D/g, "").length;

      if (!localDigits || digitCount < 8 || digitCount > 15) {
        throw new Error(
          "Enter a valid phone number (8–15 digits including country code). / देश के कोड सहित 8–15 अंकों का सही नंबर दर्ज करें।"
        );
      }

      return fullNumber;
    }

    function createCaptcha(questionId, answerInputId) {
      const first = Math.floor(Math.random() * 9) + 1;
      const second = Math.floor(Math.random() * 9) + 1;

      document.getElementById(questionId).textContent =
        `${first} + ${second} = ?`;

      document.getElementById(answerInputId).value = "";

      return first + second;
    }

    let loginCaptchaAnswer = createCaptcha(
      "loginCaptchaQuestion",
      "loginCaptchaInput"
    );

    let registerCaptchaAnswer = createCaptcha(
      "registerCaptchaQuestion",
      "registerCaptchaInput"
    );

    document.getElementById("refreshLoginCaptcha").addEventListener("click", () => {
      loginCaptchaAnswer = createCaptcha(
        "loginCaptchaQuestion",
        "loginCaptchaInput"
      );
    });

    document.getElementById("refreshRegisterCaptcha").addEventListener("click", () => {
      registerCaptchaAnswer = createCaptcha(
        "registerCaptchaQuestion",
        "registerCaptchaInput"
      );
    });

    const API_URL = "http://127.0.0.1:8000";
    const loginMobile = document.getElementById("loginMobile");
    const otpInput = document.getElementById("otp");
    const otpArea = document.getElementById("otpArea");

    function showError(error) {
      message.textContent =
        error.message || "Something went wrong. Please try again.";
      message.className = "mt-4 text-sm font-medium text-red-700";
    }

    function showSuccess(text) {
      message.textContent = text;
      message.className = "mt-4 text-sm font-medium text-green-700";
    }

    async function responseData(response) {
      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.detail || "Request failed. Please try again.");
      }

      return data;
    }

    // Request an OTP for login.
    document.getElementById("requestButton").addEventListener("click", async () => {
      try {
        const mobile_number = phoneNumber(loginCountry, loginMobile);
        const answer = Number(
          document.getElementById("loginCaptchaInput").value
        );

        if (answer !== loginCaptchaAnswer) {
          loginCaptchaAnswer = createCaptcha(
            "loginCaptchaQuestion",
            "loginCaptchaInput"
          );
          throw new Error("CAPTCHA answer is incorrect. Please try again.");
        }

        const response = await fetch(`${API_URL}/login/request-otp`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ mobile_number })
        });

        const data = await responseData(response);
        otpArea.classList.remove("hidden");

        showSuccess(
          data.otp
            ? `Demo OTP: ${data.otp}`
            : "OTP requested. Check your phone."
        );
      } catch (error) {
        showError(error);
      }
    });

    // Verify the OTP and save the logged-in user.
    document.getElementById("verifyButton").addEventListener("click", async () => {
      try {
        const mobile_number = phoneNumber(loginCountry, loginMobile);

        const response = await fetch(`${API_URL}/login/verify-otp`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            mobile_number,
            otp: otpInput.value.trim()
          })
        });

        const data = await responseData(response);

        if (data.user) {
          localStorage.setItem("kabadiwala_user", JSON.stringify(data.user));
        }

        showSuccess(
          `Welcome${data.user?.name ? `, ${data.user.name}` : ""}! Login successful.`
        );

        setTimeout(() => {
          window.location.href = "website.html";
        }, 900);
      } catch (error) {
        showError(error);
      }
    });

    // Register using the FastAPI /register endpoint.
    registerPanel.addEventListener("submit", async (event) => {
      event.preventDefault();

      try {
        const answer = Number(
          document.getElementById("registerCaptchaInput").value
        );

        if (answer !== registerCaptchaAnswer) {
          registerCaptchaAnswer = createCaptcha(
            "registerCaptchaQuestion",
            "registerCaptchaInput"
          );
          throw new Error("CAPTCHA answer is incorrect. Please try again.");
        }

        const mobile_number = phoneNumber(
          registerCountry,
          document.getElementById("registerMobile")
        );

        const response = await fetch(`${API_URL}/register`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: document.getElementById("registerName").value.trim(),
            mobile_number,
            user_type: document.getElementById("userType").value
          })
        });

        const data = await responseData(response);

        if (data.user) {
          localStorage.setItem("kabadiwala_user", JSON.stringify(data.user));
        }

        showSuccess(data.message || "Registration successful!");

        setTimeout(() => {
          window.location.href = "website.html";
        }, 900);
      } catch (error) {
        showError(error);
      }
    });
  </script>
</body>
</html>
