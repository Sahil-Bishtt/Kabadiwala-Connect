<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login / Register | Kabadiwala Connect</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <script>
    (function () {
      const savedTheme = localStorage.getItem("kabadiwala-theme");
      if (savedTheme === "dark") document.documentElement.classList.add("dark");
    })();
  </script>

  <style>
    body { transition: background-color .25s, color .25s; }
    body.dark { background-color: #111827; color: #f3f4f6; }
    body.dark #loginCard { background-color: #1f2937; color: #f3f4f6; border-color: #374151; }
    body.dark input, body.dark select { background-color: #111827; color: #f3f4f6; border-color: #4b5563; }
  </style>
</head>

<body class="min-h-screen bg-amber-50 text-gray-800 dark:bg-gray-950 dark:text-gray-100">
  <!-- Header -->
  <header class="bg-white shadow-sm dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-5 py-4">
      <a href="website.html" class="font-bold text-green-800 dark:text-green-400 text-lg">
        ♻ Kabadiwala Connect
      </a>

      <div class="flex flex-wrap items-center gap-3">
        <select id="languageSelect" aria-label="Choose language"
                class="rounded-lg border border-green-700 bg-white px-3 py-2 text-sm font-semibold text-green-800 dark:border-green-600 dark:bg-gray-800 dark:text-green-300">
          <option value="en">English</option>
          <option value="hi">हिन्दी</option>
        </select>

        <button id="themeToggle" type="button"
                class="rounded-lg border border-green-700 px-4 py-2 text-sm font-semibold text-green-800 dark:border-green-600 dark:bg-gray-800 dark:text-green-300">
          🌙 Dark mode
        </button>

        <a href="website.html" class="text-sm text-green-700 hover:underline dark:text-green-400"
           data-en="Back to home" data-hi="मुखपृष्ठ पर वापस जाएँ">
          Back to home
        </a>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-md px-5 py-12">
    <!-- Main Auth Card -->
    <section id="loginCard" class="rounded-2xl border border-green-100 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900">
      
      <!-- Session Logged-In Display -->
      <div id="sessionBanner" class="hidden text-center mb-6 p-4 rounded-xl bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800">
        <p class="font-bold text-green-900 dark:text-green-200 text-lg" id="sessionUserGreeting"></p>
        <p class="text-xs text-green-700 dark:text-green-400 mt-1" id="sessionRoleDetail"></p>
        <div class="mt-4 flex justify-center gap-3">
          <a href="pickup.html" class="rounded-lg bg-green-700 px-4 py-2 text-xs font-bold text-white hover:bg-green-800">Request Pickup</a>
          <button id="logoutBtnCard" type="button" class="rounded-lg border border-red-600 px-4 py-2 text-xs font-bold text-red-600 hover:bg-red-50 dark:hover:bg-red-950">Log Out</button>
        </div>
      </div>

      <!-- Auth Tabs: Login vs Register -->
      <div id="authTabs" class="flex border-b border-gray-200 dark:border-gray-700 mb-6">
        <button id="tabLoginBtn" type="button" class="w-1/2 py-2.5 font-bold text-green-800 dark:text-green-400 border-b-2 border-green-700 text-center"
                data-en="Login" data-hi="लॉग इन">
          Login
        </button>
        <button id="tabRegisterBtn" type="button" class="w-1/2 py-2.5 font-semibold text-gray-500 dark:text-gray-400 border-b-2 border-transparent text-center hover:text-green-700"
                data-en="Register" data-hi="पंजीकरण">
          Register
        </button>
      </div>

      <!-- FORM 1: LOGIN FLOW -->
      <form id="loginForm" class="space-y-4">
        <div>
          <label class="block font-semibold text-sm" for="mobile" data-en="Mobile number" data-hi="मोबाइल नंबर">
            Mobile number
          </label>
          <input id="mobile" type="tel" placeholder="Enter mobile number" required pattern="[0-9]{10}"
                 class="mt-1.5 w-full rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2.5 text-sm focus:ring-2 focus:ring-green-600 focus:outline-none" />
        </div>

        <button id="requestOtpBtn" type="button"
                class="w-full rounded-lg bg-green-700 px-6 py-3 font-bold text-white hover:bg-green-800 transition-colors disabled:opacity-50"
                data-en="Request OTP" data-hi="OTP माँगें">
          Request OTP
        </button>

        <!-- Dynamic OTP Verification Area -->
        <div id="otpArea" class="hidden space-y-4 pt-2 border-t border-gray-100 dark:border-gray-800">
          <div>
            <label class="block font-semibold text-sm" for="otp" data-en="Enter OTP" data-hi="OTP दर्ज करें">
              Enter OTP
            </label>
            <input id="otp" type="text" inputmode="numeric" maxlength="4" placeholder="4-digit OTP"
                   class="mt-1.5 w-full rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2.5 text-sm focus:ring-2 focus:ring-green-600 focus:outline-none" />
          </div>

          <button id="verifyOtpBtn" type="button"
                  class="w-full rounded-lg bg-green-700 px-6 py-3 font-bold text-white hover:bg-green-800 transition-colors disabled:opacity-50"
                  data-en="Verify and log in" data-hi="सत्यापित करें और लॉग इन करें">
            Verify and log in
          </button>
        </div>
      </form>

      <!-- FORM 2: REGISTRATION FLOW -->
      <form id="registerForm" class="hidden space-y-4">
        <div>
          <label class="block font-semibold text-sm" for="regName" data-en="Full Name" data-hi="पूरा नाम">Full Name</label>
          <input id="regName" type="text" minlength="2" maxlength="40" placeholder="e.g. Rahul Sharma" required
                 class="mt-1.5 w-full rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2.5 text-sm focus:ring-2 focus:ring-green-600 focus:outline-none" />
        </div>

        <div>
          <label class="block font-semibold text-sm" for="regMobile" data-en="Mobile Number" data-hi="मोबाइल नंबर">Mobile Number</label>
          <input id="regMobile" type="tel" placeholder="10-digit mobile number" required pattern="[0-9]{10}"
                 class="mt-1.5 w-full rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2.5 text-sm focus:ring-2 focus:ring-green-600 focus:outline-none" />
        </div>

        <div>
          <label class="block font-semibold text-sm" for="regUserType" data-en="Account Type" data-hi="खाता का प्रकार">Account Type</label>
          <select id="regUserType" class="mt-1.5 w-full rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2.5 text-sm focus:ring-2 focus:ring-green-600 focus:outline-none">
            <option value="Household">Household (Sell Scrap)</option>
            <option value="Collector">Collector (Buy Scrap)</option>
          </select>
        </div>

        <button id="registerSubmitBtn" type="button"
                class="w-full rounded-lg bg-green-700 px-6 py-3 font-bold text-white hover:bg-green-800 transition-colors disabled:opacity-50"
                data-en="Register Account" data-hi="खाता बनाएँ">
          Register Account
        </button>
      </form>

      <!-- Global Response & Status Messaging -->
      <div id="messageBox" aria-live="polite" class="mt-4 rounded-lg p-3 text-sm hidden"></div>
    </section>
  </main>

  <!-- AUTH LOGIC & API INTEGRATION -->
  <script>
    const API_URL = "http://127.0.0.1:8000";

    const themeToggle = document.getElementById("themeToggle");
    const languageSelect = document.getElementById("languageSelect");
    const messageBox = document.getElementById("messageBox");

    // UI Helper: Display Alerts
    function displayMsg(text, isError = false) {
      messageBox.classList.remove("hidden", "bg-red-100", "text-red-800", "bg-green-100", "text-green-800", "dark:bg-red-950", "dark:text-red-200", "dark:bg-green-950", "dark:text-green-200");
      if (isError) {
        messageBox.classList.add("bg-red-100", "text-red-800", "dark:bg-red-950", "dark:text-red-200");
      } else {
        messageBox.classList.add("bg-green-100", "text-green-800", "dark:bg-green-950", "dark:text-green-200");
      }
      messageBox.textContent = text;
    }

    // Theme & Lang Sync
    function applyTheme() {
      const isDark = localStorage.getItem("kabadiwala-theme") === "dark";
      document.documentElement.classList.toggle("dark", isDark);
      document.body.classList.toggle("dark", isDark);
      themeToggle.textContent = isDark ? "☀️ Light mode" : "🌙 Dark mode";
    }

    function applyLanguage(language) {
      document.documentElement.lang = language;
      document.querySelectorAll("[data-en][data-hi]").forEach((el) => {
        el.textContent = el.dataset[language];
      });
      if (languageSelect) languageSelect.value = language;
    }

    applyTheme();
    applyLanguage(localStorage.getItem("kabadiwala-language") || "en");

    themeToggle.addEventListener("click", () => {
      const isDark = !document.body.classList.contains("dark");
      localStorage.setItem("kabadiwala-theme", isDark ? "dark" : "light");
      applyTheme();
    });

    languageSelect.addEventListener("change", (e) => {
      localStorage.setItem("kabadiwala-language", e.target.value);
      applyLanguage(e.target.value);
    });

    // Check Existing Session
    function checkExistingSession() {
      const userRaw = localStorage.getItem("kabadiwala_user");
      if (userRaw) {
        try {
          const user = JSON.parse(userRaw);
          document.getElementById("sessionBanner").classList.remove("hidden");
          document.getElementById("sessionUserGreeting").textContent = `Welcome back, ${user.name}!`;
          document.getElementById("sessionRoleDetail").textContent = `Logged in as ${user.user_type} (${user.mobile_number})`;
          document.getElementById("authTabs").classList.add("hidden");
          document.getElementById("loginForm").classList.add("hidden");
          document.getElementById("registerForm").classList.add("hidden");
        } catch (e) {
          localStorage.removeItem("kabadiwala_user");
        }
      }
    }
    checkExistingSession();

    document.getElementById("logoutBtnCard")?.addEventListener("click", () => {
      localStorage.removeItem("kabadiwala_user");
      window.location.reload();
    });

    // Auth Mode Tab Switcher
    const tabLoginBtn = document.getElementById("tabLoginBtn");
    const tabRegisterBtn = document.getElementById("tabRegisterBtn");
    const loginForm = document.getElementById("loginForm");
    const registerForm = document.getElementById("registerForm");

    tabLoginBtn.addEventListener("click", () => {
      tabLoginBtn.className = "w-1/2 py-2.5 font-bold text-green-800 dark:text-green-400 border-b-2 border-green-700 text-center";
      tabRegisterBtn.className = "w-1/2 py-2.5 font-semibold text-gray-500 dark:text-gray-400 border-b-2 border-transparent text-center hover:text-green-700";
      loginForm.classList.remove("hidden");
      registerForm.classList.add("hidden");
      messageBox.classList.add("hidden");
    });

    tabRegisterBtn.addEventListener("click", () => {
      tabRegisterBtn.className = "w-1/2 py-2.5 font-bold text-green-800 dark:text-green-400 border-b-2 border-green-700 text-center";
      tabLoginBtn.className = "w-1/2 py-2.5 font-semibold text-gray-500 dark:text-gray-400 border-b-2 border-transparent text-center hover:text-green-700";
      registerForm.classList.remove("hidden");
      loginForm.classList.add("hidden");
      messageBox.classList.add("hidden");
    });

    // 1. POST /register
    document.getElementById("registerSubmitBtn").addEventListener("click", async () => {
      const name = document.getElementById("regName").value.trim();
      const mobile_number = document.getElementById("regMobile").value.trim();
      const user_type = document.getElementById("regUserType").value;

      if (name.length < 2 || name.length > 40) {
        displayMsg("Name must be between 2 and 40 characters.", true);
        return;
      }
      if (!mobile_number) {
        displayMsg("Please enter a valid mobile number.", true);
        return;
      }

      const btn = document.getElementById("registerSubmitBtn");
      btn.disabled = true;
      btn.textContent = "Registering...";

      try {
        const response = await fetch(`${API_URL}/register`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, mobile_number, user_type })
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.detail || "Registration failed.");

        displayMsg(`Registration successful! Please login with mobile ${data.user.mobile_number}.`, false);
        document.getElementById("mobile").value = data.user.mobile_number;
        tabLoginBtn.click();
      } catch (error) {
        displayMsg(error.message, true);
      } finally {
        btn.disabled = false;
        btn.textContent = "Register Account";
      }
    });

    // 2. POST /login/request-otp
    document.getElementById("requestOtpBtn").addEventListener("click", async () => {
      const mobile_number = document.getElementById("mobile").value.trim();
      if (!mobile_number) {
        displayMsg("Enter your registered mobile number first.", true);
        return;
      }

      const btn = document.getElementById("requestOtpBtn");
      btn.disabled = true;
      btn.textContent = "Sending OTP...";

      try {
        const response = await fetch(`${API_URL}/login/request-otp`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ mobile_number })
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.detail || "Could not request OTP.");

        document.getElementById("otpArea").classList.remove("hidden");
        displayMsg(`OTP sent! Prototype Demo OTP: [ ${data.otp} ]`, false);
      } catch (error) {
        displayMsg(error.message, true);
      } finally {
        btn.disabled = false;
        btn.textContent = "Request OTP";
      }
    });

    // 3. POST /login/verify-otp
    document.getElementById("verifyOtpBtn").addEventListener("click", async () => {
      const mobile_number = document.getElementById("mobile").value.trim();
      const otp = document.getElementById("otp").value.trim();

      if (!otp) {
        displayMsg("Please enter the 4-digit OTP.", true);
        return;
      }

      const btn = document.getElementById("verifyOtpBtn");
      btn.disabled = true;
      btn.textContent = "Verifying...";

      try {
        const response = await fetch(`${API_URL}/login/verify-otp`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ mobile_number, otp })
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.detail || "OTP verification failed.");

        // Store user state in localStorage
        localStorage.setItem("kabadiwala_user", JSON.stringify(data.user));
        displayMsg(`Welcome ${data.user.name}! Redirecting...`, false);
        
        setTimeout(() => {
          window.location.href = "pickup.html";
        }, 1000);
      } catch (error) {
        displayMsg(error.message, true);
      } finally {
        btn.disabled = false;
        btn.textContent = "Verify and log in";
      }
    });
  </script>
</body>
</html>
